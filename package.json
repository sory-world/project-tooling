{
  "name": "@sory-world/project-tooling",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "check:biome": "biome ci .",
    "check:packages": "publint packages/biome-config --strict --pack npm",
    "check": "pnpm check:biome && pnpm check:packages",
    "fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@sory-world/biome-config": "workspace:*",
    "publint": "0.3.22"
  }
}
